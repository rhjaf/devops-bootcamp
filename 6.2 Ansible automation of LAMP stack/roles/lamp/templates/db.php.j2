<?php

$host = "{{ lamp_db_host }}";
$db   = "{{ lamp_db_name }}";
$user = "{{ lamp_db_user }}";
$pass = "{{ lamp_db_password }}";

try {
    $pdo = new PDO(
        "mysql:host=$host;dbname=$db;charset=utf8mb4",
        $user,
        $pass
    );

    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

} catch (PDOException $e) {
    die("Database connection failed.");
}
